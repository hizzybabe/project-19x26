{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-19x26.local/schema/catalog.schema.json",
  "title": "PROJECT 19X26 content catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "monsters", "skills", "dungeons", "events", "affixes", "legendaryPowers"],
  "properties": {
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "monsters": {"type": "array", "items": {"$ref": "#/$defs/monster"}},
    "skills": {"type": "array", "items": {"$ref": "#/$defs/skill"}},
    "dungeons": {"type": "array", "items": {"$ref": "#/$defs/dungeon"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "affixes": {"type": "array", "items": {"$ref": "#/$defs/named"}},
    "legendaryPowers": {"type": "array", "items": {"$ref": "#/$defs/named"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "named": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}}},
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "slot", "rarity", "itemLevel", "weight", "enhancement", "bonusStr", "bonusVit", "value"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1},
        "slot": {"enum": ["weapon", "armor"]}, "rarity": {"enum": ["Common", "Uncommon", "Rare", "Epic", "Legendary"]},
        "itemLevel": {"type": "integer", "minimum": 1}, "weight": {"type": "number", "minimum": 0},
        "weaponFactor": {"type": "number", "exclusiveMinimum": 0}, "armor": {"type": "number", "minimum": 0},
        "enhancement": {"type": "integer", "minimum": 0}, "bonusStr": {"type": "integer", "minimum": 0},
        "bonusVit": {"type": "integer", "minimum": 0}, "value": {"type": "integer", "minimum": 0}
      },
      "oneOf": [
        {"properties": {"slot": {"const": "weapon"}}, "required": ["weaponFactor"], "not": {"required": ["armor"]}},
        {"properties": {"slot": {"const": "armor"}}, "required": ["armor"], "not": {"required": ["weaponFactor"]}}
      ]
    },
    "monster": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "enemyClass", "levelOffset", "attackIntervalMs", "dodge"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1},
        "enemyClass": {"enum": ["Minion", "Normal", "Veteran", "Elite", "Boss"]},
        "levelOffset": {"type": "integer"}, "attackIntervalMs": {"type": "integer", "minimum": 1},
        "dodge": {"type": "number", "minimum": 0, "maximum": 1}, "firstTelegraphMs": {"type": "integer", "minimum": 1}
      }
    },
    "skill": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "manaCost", "cooldownMs", "coefficient"],
      "properties": {
        "id": {"enum": ["heavy", "cleave", "execute"]}, "name": {"type": "string", "minLength": 1},
        "manaCost": {"type": "integer", "minimum": 0}, "cooldownMs": {"type": "integer", "minimum": 0},
        "coefficient": {"type": "number", "exclusiveMinimum": 0}, "lowHealthCoefficient": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "room": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "kind", "monsterIds"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "kind": {"enum": ["combat", "event", "elite", "shrine", "boss"]},
        "monsterIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "eventId": {"$ref": "#/$defs/id"}
      }
    },
    "dungeon": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "rooms"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "rooms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/room"}}}
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "choices"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "choices": {"type": "array", "items": {"$ref": "#/$defs/id"}}}
    }
  }
}
